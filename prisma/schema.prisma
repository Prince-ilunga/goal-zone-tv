// Prisma schema — GOAL ZONE TV
// Provider is auto-switched by scripts/setup-db.js according to DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Article {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  excerpt      String
  content      String
  scope        String   @default("NATIONAL") // PROVINCIAL | NATIONAL | INTERNATIONAL
  sport        String   @default("FOOTBALL") // FOOTBALL | BASKETBALL | BOXE | ATHLETISME | AUTRE
  imageUrl     String?
  imageAlt     String?
  videoUrl     String?
  featured     Boolean  @default(false)
  breaking     Boolean  @default(false)
  views        Int      @default(0)
  readMinutes  Int      @default(2)
  source       String?
  location     String?
  published    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  likes    Like[]
  comments Comment[]

  @@index([scope])
  @@index([sport])
  @@index([featured])
  @@index([breaking])
  @@index([createdAt])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Like {
  id          String   @id @default(cuid())
  articleId   String
  fingerprint String
  createdAt   DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, fingerprint])
  @@index([articleId])
}

model Comment {
  id        String   @id @default(cuid())
  articleId String
  name      String
  content   String
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
}

model SiteStats {
  id             String   @id @default(cuid())
  followers      Int      @default(0)
  articlesCount  Int      @default(0)
  createdAt      DateTime @default(now())
}

// Matchs manuels (LINAFOOT, ligue provinciale) — saisis par Moïse Kalala
// Les scores internationaux (Premier League, etc.) viennent de l'API-Football
model Match {
  id           String   @id @default(cuid())
  competition  String   // "LINAFOOT", "Ligue Provinciale Haut-Katanga", etc.
  homeTeam     String
  awayTeam     String
  homeScore    Int      @default(0)
  awayScore    Int      @default(0)
  status       String   @default("upcoming") // "live" | "finished" | "upcoming"
  minute       String   @default("")  // "67'" | "HT" | "FT" | "20:00"
  matchDate    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([competition])
  @@index([status])
}
